+static void og_load_references() {
+	if (!og_cfg.guard_file.empty()) {
+		std::vector<uint8> f;
+		uint8* img = nullptr;
+		size_t n = og_read_file(og_cfg.guard_file, f) ? og_pe_canonical(f.data(), f.size(), OG_CANON_CODE | OG_CANON_RDATA, &img) : 0;
+		if (n) {
+			og_cfg.guard_image.assign(img, img + n);
+			uint8 h[32];
+			crypto_blake2b(h, 32, img, n);
+			og_cfg.guard_code = to_hex(h, 32);
+			ShowStatus("OdinGuard: guard reference %s (%u bytes, code %.16s).\n", og_cfg.guard_file.c_str(), (uint32)n, og_cfg.guard_code.c_str());
+		} else
+			ShowError("OdinGuard: og_guard_file '%s' is not a usable guard DLL.\n", og_cfg.guard_file.c_str());
+		free(img);
+	}
+	og_cfg.guard_previous_codes.clear();
+	for (const std::string& path : og_cfg.guard_previous_files) {
+		std::vector<uint8> f;
+		uint8* img = nullptr;
+		size_t n = og_read_file(path, f) ? og_pe_canonical(f.data(), f.size(), OG_CANON_CODE | OG_CANON_RDATA, &img) : 0;
+		if (n) {
+			uint8 h[32];
+			crypto_blake2b(h, 32, img, n);
+			og_cfg.guard_previous_codes.push_back(to_hex(h, 32));
+			ShowStatus("OdinGuard: previous guard %s accepted (code %.16s).\n", path.c_str(), og_cfg.guard_previous_codes.back().c_str());
+		} else
+			ShowError("OdinGuard: og_guard_previous_file '%s' is not a usable guard DLL.\n", path.c_str());
+		free(img);
+	}
+	if (!og_cfg.exe_reference.empty() && !og_read_file(og_cfg.exe_reference, og_cfg.exe_image))
+		ShowError("OdinGuard: og_exe_reference '%s' not found.\n", og_cfg.exe_reference.c_str());
+	for (const s_og_file& f : og_cfg.files) {
+		if (og_file_size(f.path) < 0) ShowError("OdinGuard: protected file %d '%s' not found on the server.\n", f.index, f.path.c_str());
+		for (const std::string& prev : f.previous)
+			if (og_file_size(prev) < 0) ShowError("OdinGuard: previous version '%s' of protected file %d not found.\n", prev.c_str(), f.index);
+			else ShowStatus("OdinGuard: protected file %d also accepts %s.\n", f.index, prev.c_str());
+	}
+}
+
+void og_init() {
+	og_config_bootstrap();
+	if (!og_config_read(OG_CONF_FILE))
+		return;
+	const char* env = getenv("ODINGUARD_KEY");
+	if (env != nullptr && *env) og_cfg.key_hex = env;
+	if ((env = getenv("ODINGUARD_PROTO_SALT")) != nullptr && *env) og_cfg.salt_hex = env;
+	if ((env = getenv("ODINGUARD_BUILD_SECRET")) != nullptr && *env) og_cfg.secret_hex = env;
+	if (!og_cfg.enable) return;
+
+	uint8 seed[32];
+	if (!from_hex(og_cfg.key_hex, seed, sizeof(seed))) {
+		ShowError("OdinGuard: og_key / ODINGUARD_KEY missing or invalid (64 hex characters). OdinGuard disabled.\n");
+		og_cfg.enable = false;
+		return;
+	}
+	if (!og_cfg.salt_hex.empty() && !from_hex(og_cfg.salt_hex, og_cfg.salt, OG_SALT_LEN)) {
+		ShowError("OdinGuard: og_proto_salt must be 32 hex characters. OdinGuard disabled.\n");
+		og_cfg.enable = false;
+		return;
+	}
+	if (!og_cfg.secret_hex.empty() && !from_hex(og_cfg.secret_hex, og_cfg.secret, 32))
+		ShowError("OdinGuard: og_build_secret must be 64 hex characters; nonce and time challenges will fail.\n");
+	{
+		static const char label[] = "OdinGuard/tag";
+		crypto_blake2b_ctx c;
+		crypto_blake2b_init(&c, OG_TAG_LEN);
+		crypto_blake2b_update(&c, (const uint8*)label, sizeof(label) - 1);
+		crypto_blake2b_update(&c, og_cfg.salt, OG_SALT_LEN);
+		crypto_blake2b_final(&c, og_cfg.tag);
+	}
+	crypto_eddsa_key_pair(og_cfg.sk, og_cfg.pk, seed);
+	crypto_wipe(seed, sizeof(seed));
+	if (!og_cfg.sigpack.empty() && og_module_on("og_signatures", true))
+		og_load_sigpack();
+	og_load_references();
+	add_timer_func_list(og_alive_check, "og_alive_check");
+	add_timer_interval(gettick() + 5000, og_alive_check, 0, 0, 5000);
+	ShowStatus("OdinGuard Anti Cheat: enabled (required: %s, log only: %s, min release: %s, %d signatures, challenges%s%s%s%s), server key %s, profile tag %s\n",
+		og_cfg.required ? "yes" : "no", og_cfg.log_only ? "yes" : "no", og_cfg.min_release ? og_release_str(og_cfg.min_release).c_str() : "any", (int32)og_cfg.signatures.size(),
+		og_cfg.ch[OG_CH_NONCE].enable ? " nonce" : "", og_cfg.ch[OG_CH_CODE_RANGE].enable ? " code" : "",
+		og_cfg.ch[OG_CH_TIME].enable ? " time" : "", og_cfg.ch[OG_CH_FILE_RANGE].enable ? " file" : "",
+		to_hex(og_cfg.pk, 32).c_str(), to_hex(og_cfg.tag, OG_TAG_LEN).c_str());
+}
+
+void og_final() {
+	crypto_wipe(og_cfg.sk, sizeof(og_cfg.sk));
+	crypto_wipe(og_cfg.secret, sizeof(og_cfg.secret));
+}
diff --git a/src/common/odinguard.hpp b/src/common/odinguard.hpp
new file mode 100644
index 000000000..cae781210
--- /dev/null
+++ b/src/common/odinguard.hpp
@@ -0,0 +1,106 @@
+// OdinGuard server side: handshake, encrypted record layer and policy for client connections.
+// Wire format: og_proto.h (shared with the OdinGuard client DLL).
+
+#ifndef ODINGUARD_HPP
+#define ODINGUARD_HPP
+
+#include <initializer_list>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "cbasetypes.hpp"
+
+enum e_og_action : uint8 {
+	OG_ACTION_LOG = 0,
+	OG_ACTION_KICK,
+	OG_ACTION_BAN,
+	OG_ACTION_FLAG,    // flag with a score, the player stays online
+	OG_ACTION_FLAGBAN, // flag now, ban with the next ban wave (the player cannot tell which check fired)
+};
+const char* og_action_name(e_og_action a);
+
+struct s_og_info {
+	std::string unique_id; // hex
+	std::string exe_code;  // hex, latest reported (BLAKE2b of the canonical exe code)
+	std::string guard_code; // hex, latest reported (BLAKE2b of the canonical guard code + read-only data)
+	std::string build;
+	uint8 flags = 0;
+	uint8 version = 0;
+	uint32 release = 0;       // guard release (major << 16 | minor << 8 | patch) from the og-release component; 0 = before 1.0.3
+	std::string lang;         // the player's language ("de") from the og-lang component; empty = guard before 1.0.5
+	bool darkpack = false;    // odin-dark.grf is loaded and accepted (OG_ALIVE_DARKPACK)
+	bool alive_seen = false;  // the first heartbeat has arrived (darkpack is only known from then on)
+	bool lgp_palette = false; // the client draws the LGP colour units (OG_ALIVE_LGP_PALETTE)
+	std::vector<std::pair<std::string, std::string>> components; // name, hex hash
+};
+
+void og_init();
+void og_final();
+bool og_enabled();
+bool og_required();
+bool og_log_only();
+int32 og_ban_match();
+int32 og_max_per_machine();
+std::string og_release_str(uint32 release); // "1.0.3"; 0 = "older than 1.0.3"
+
+// Texts for a player, in the language the guard reported: built-in German, conf og_text_<lang>_<key> for more languages
+// or changes, else the English text given here. {1}, {2}, {3} are replaced by args. The result is in the client's
+// character set (og_client_charset), ready for clif_displaymessage.
+std::string og_text(int32 fd, const char* key, const char* en, std::initializer_list<std::string> args = {});
+std::string og_text_lang(const std::string& lang, const char* key, const char* en, std::initializer_list<std::string> args = {});
+// UTF-8 (our texts, texts of 1.0.5 guards, web panels) to the client's character set: cp1252 (default) or utf8 (as is)
+std::string og_client_charset(const std::string& utf8);
+uint32 og_sigpack_version();
+
+// values of conf/odinguard_athena.conf read by the server modules (og_rate_*, og_bh_*, og_banwave_*, og_cmd_* ...)
+const char* og_setting(const char* key, const char* def);
+int32 og_setting_int(const char* key, int32 def);
+e_og_action og_setting_action(const char* key, e_og_action def);
+bool og_module_on(const char* key, bool def); // module switch, always false while OdinGuard is disabled
+
+// reports a detection: event log, flag score or action (warn mode turns every action into log)
+void og_report(int32 fd, const char* type, const char* detail, e_og_action action, int32 score);
+
+// state of a client connection
+bool og_session_active(int32 fd);
+const s_og_info* og_info(int32 fd);
+
+// socket layer
+bool og_handles_recv(int32 fd);
+int32 og_recv(int32 fd);
+bool og_handles_send(int32 fd);
+int32 og_send(int32 fd);
+bool og_has_pending(int32 fd);
+void og_session_free(int32 fd);
+void og_mark_plain(int32 fd);
+
+// server -> client
+bool og_send_ping(int32 fd);
+bool og_send_control(int32 fd, const std::vector<uint8>& msg);
+bool og_send_command(int32 fd, const char* command);
+bool og_send_crash_endpoint(int32 fd, const std::string& url, std::string& token);
+
+// callbacks set by the servers
+typedef void (*og_event_handler)(int32 fd, const char* type, const char* detail, e_og_action action, int32 score);
+typedef void (*og_text_handler)(int32 fd, const char* text);
+typedef void (*og_pong_handler)(int32 fd, int64 rtt_ms);
+void og_set_handlers(og_event_handler ev, og_text_handler text, og_pong_handler pong);
+
+// display features (map-server)
+const std::vector<std::pair<int32, uint32>>& og_item_colors();       // item id, 0xRRGGBB
+const std::vector<std::pair<int32, uint32>>& og_group_namecolors();  // group id, 0xRRGGBB
+uint16 og_lgp_unit(uint16 skill_id);                                  // square style; 0 = no lite display for the skill
+// entry of a style (square | circle | setN): the ground unit and the colour number (-1 = fixed unit, no colour)
+bool og_lgp_entry(const char* style, uint16 skill_id, uint16* unit, int32* color_index);
+bool og_lgp_attacks(uint16 skill_id);                                 // hostile skill: triangle
+enum { OG_LGP_SOUND_CAST = 0, OG_LGP_SOUND_UNIT = 1, OG_LGP_SOUND_TRAP = 2 };
+bool og_lgp_has_sound(uint16 skill_id, int32 kind = OG_LGP_SOUND_CAST); // sound og_<id>.wav is sent to LGP players: when cast, when the unit appears, when the trap goes off
+int32 og_lgp_symbol(uint16 skill_id);                                 // symbol number inside the tiles (0 = none)
+int32 og_lgp_color_count();                                           // og_lgp_color lines
+int32 og_lgp_color_value(int32 pos);                                  // colour number of the pos-th og_lgp_color line
+
+// CREATE TABLE IF NOT EXISTS statements (login and map server run them at start)
+const std::vector<const char*>& og_sql_ddl();
+
+#endif /* ODINGUARD_HPP */
