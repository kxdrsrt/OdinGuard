+	nullpo_retr(-1, sd);
+	if (!message || !*message || sscanf(message, "%23[^,],%127[^\n]", name, reason) < 1) {
+		clif_displaymessage(fd, "Usage: @ogban <character name>[, reason]");
+		return -1;
+	}
+	trim(name);
+	trim(reason);
+	map_session_data* pl = map_nick2sd(name, false);
+	if (pl == nullptr) {
+		clif_displaymessage(fd, msg_txt(sd, 3)); // Character not found.
+		return -1;
+	}
+	if (pc_get_group_level(pl) >= pc_get_group_level(sd)) {
+		clif_displaymessage(fd, msg_txt(sd, 81)); // Your GM level don't authorise you to do this action on this player.
+		return -1;
+	}
+	if (!og_map_ban(pl, sd->status.name, *reason ? reason : "GM ban")) {
+		clif_displaymessage(fd, "This character has no OdinGuard session; use @ban for the account.");
+		return -1;
+	}
+	clif_displaymessage(fd, "Machine banned and character kicked.");
+	return 0;
+}
+
+/// OdinGuard: lock an account to machines. @oglock <character name>[, add|remove|clear|list]
+/// add/remove: the machine the character plays on now; with entries the account logs in only from these machines.
+ACMD_FUNC(oglock)
+{
+	char name[NAME_LENGTH], op[16] = "list";
+	nullpo_retr(-1, sd);
+	if (!message || !*message || sscanf(message, "%23[^,],%15s", name, op) < 1) {
+		clif_displaymessage(fd, "Usage: @oglock <character name>[, add|remove|clear|list]");
+		return -1;
+	}
+	trim(name);
+	map_session_data* pl = map_nick2sd(name, false);
+	if (pl == nullptr) {
+		clif_displaymessage(fd, msg_txt(sd, 3)); // Character not found.
+		return -1;
+	}
+	if (strcmpi(op, "add") && strcmpi(op, "remove") && strcmpi(op, "clear") && strcmpi(op, "list")) {
+		clif_displaymessage(fd, "Usage: @oglock <character name>[, add|remove|clear|list]");
+		return -1;
+	}
+	std::vector<std::string> lines;
+	if (!og_map_lock(pl, op, sd->status.name, lines)) {
+		clif_displaymessage(fd, "This character has no OdinGuard session.");
+		return -1;
+	}
+	char out[CHAT_SIZE_MAX];
+	safesnprintf(out, sizeof(out), "Account lock of %s: %d machine(s)%s", pl->status.name, (int32)lines.size(), lines.empty() ? " (not locked)." : ":");
+	clif_displaymessage(fd, out);
+	for (const std::string& l : lines)
+		clif_displaymessage(fd, l.c_str());
+	return 0;
+}
+
+/// OdinGuard: lift the machine bans of all machines an account used. @ogunban <account id>
+ACMD_FUNC(ogunban)
