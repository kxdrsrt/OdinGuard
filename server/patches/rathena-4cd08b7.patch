+// OdinGuard Anti Cheat settings. Local overrides: conf/import/odinguard_conf.txt (created at the first start).
+// The OdinGuard Studio generates the profile values (key, proto salt, build secret, signature package, module
+// switches, commands, auras) into conf/import/odinguard_conf.txt; the environment variables ODINGUARD_KEY,
+// ODINGUARD_PROTO_SALT and ODINGUARD_BUILD_SECRET override them (keep them out of git).
+
+// Turn the protocol on. Clients with OdinGuard then talk encrypted; clients without it still work
+// unless og_required is on.
+og_enable: no
+
+// Refuse logins (and char/map connections) of clients without OdinGuard.
+og_required: no
+
+// Only write events (console + og_event table) instead of kicking/banning. Use it for the first days.
+og_log_only: yes
+
+// Ed25519 seed of the server, 64 hex characters (tools/og_keygen.py in the OdinGuard repo).
+// Keep it secret; the matching public key is compiled into odinguard.dll.
+//og_key:
+
+// Oldest accepted client protocol version (2 = OdinGuard Anti Cheat 1.x; lower values are raised to 2).
+og_min_version: 2
+
+// Oldest accepted guard release (major.minor.patch). An older guard is refused at the handshake: the player sees
+// og_outdated_message in a message box and cannot log in, nothing is logged as a cheat. Clients before 1.0.3 do not
+// report their release and count as older than 1.0.3. 0 = every release (soft rollout, see og_guard_previous_file).
+// The Studio writes the release it built (or 0 while [rollout] previous_releases is set).
+og_min_release: 0
+// {have} = release of the player's guard, {need} = og_min_release. At most 400 characters.
+og_outdated_message: Your client is outdated (OdinGuard {have}). This server needs OdinGuard {need} or newer. Please start the patcher, then log in again.
+// Guards from 1.0.5 report the player's language (Windows, or odinguard.ini Language=). German is built in; a line
+// og_outdated_message_<lang> overrides it or adds a language. Guards before 1.0.5 get og_outdated_message.
+//og_outdated_message_de: Dein Client ist veraltet (OdinGuard {have}). Dieser Server braucht OdinGuard {need} oder neuer. Bitte starte den Patcher und logge dich dann erneut ein.
+
+// Texts for players (chat replies of @lgp, @pf, @spb, commands, ping ...) in the player's language: English and German
+// are built in; og_text_<lang>_<key>: <text> (UTF-8) adds a language or replaces one text. Keys and the German texts:
+// og_texts_de in src/common/odinguard.cpp. {1} {2} {3} are filled in. Example:
+//og_text_fr_cmd_wait: Patientez un instant avant de réutiliser cette commande.
+// Character set the game client shows: cp1252 (Western Windows, default; UTF-8 texts are converted) or utf8.
+og_client_charset: cp1252
+
+// Profile values of the client build (Studio): protocol salt (32 hex) and build secret (64 hex). A client built
+// for another profile is refused with a message. Empty salt = the development profile.
+//og_proto_salt:
+//og_build_secret:
+
+// Heartbeat: the client reports every og_alive_interval seconds, missing reports for
+// og_alive_timeout seconds disconnect the player.
+og_alive_interval: 30
+og_alive_timeout: 120
+
+// Client side: maximum game windows per computer (0 = unlimited) and refuse virtual machines.
+og_max_windows: 0
+og_block_vm: no
+og_vm_action: kick
+
+// Server side: maximum characters online from one machine (hardware id; 0 = unlimited, GMs not counted).
+og_max_per_machine: 0
+
+// A login is refused when at least this many identifying hardware parts (machine guid, volume serial,
+// disk serial, mac, smbios uuid) are equal to those of a banned machine. The new id is banned too.
+og_ban_match: 2
+
+// Block synthetic mouse/keyboard input (macros, auto-pot tools) in the game window.
+og_input_filter: no
+
+// Report resource overrides (loose files in data\ or unknown GRFs that replace protected files).
+og_grf_strict: no
+
+// Actions: log, kick, ban (machine ban + kick), flag (score in og_flag, player stays) or flagban (flag now, ban
+// with the next ban wave, so a cheater cannot tell which check fired).
+og_integrity_action: kick
+og_tamper_action: kick
+og_grf_action: kick
+og_inject_action: log
+
+// Allowed in-memory code hashes of the game exe (from the client report, odinguard.log "exe_code").
+// Empty = every exe is accepted. One line per allowed build.
+//og_allowed_exe: <64 hex characters>
+
+// Known cheat and automation tools: kind (process, window or module), action, pattern.
+// The pattern is matched case-insensitively as part of the process file name, the window title
+// or the module file name. The list is sent to the client at login, so it can be changed
+// without a client update.
+og_signature: process,kick,openkore
+og_signature: window,kick,OpenKore
+og_signature: process,kick,wpepro
+og_signature: window,kick,WPE PRO
+og_signature: module,kick,wpespy
+og_signature: process,kick,rpe.exe
+og_signature: window,kick,Redox Packet Editor
+og_signature: process,kick,potnd
+og_signature: window,kick,PotND
+og_signature: process,kick,meth4u
+og_signature: process,kick,xrag
+og_signature: window,kick,xRag
+og_signature: process,kick,xlike
+og_signature: window,kick,xLike
+og_signature: process,kick,rotools
+og_signature: window,kick,RO Tools
+og_signature: process,kick,cheatengine
+og_signature: window,kick,Cheat Engine
+og_signature: module,kick,speedhack-i386
+og_signature: module,kick,vehdebug-i386
+og_signature: process,log,x32dbg
+og_signature: process,log,ollydbg
