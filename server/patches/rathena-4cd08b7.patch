+		clif_displaymessage(fd, "Usage: @ogflagclear <name|account id> [rule]");
+		return -1;
+	}
+	map_session_data* pl = map_nick2sd(who, false);
+	uint32 account_id = pl != nullptr ? pl->status.account_id : (uint32)strtoul(who, nullptr, 10);
+	if (account_id == 0) {
+		clif_displaymessage(fd, msg_txt(sd, 3)); // Character not found.
+		return -1;
+	}
+	char out[CHAT_SIZE_MAX];
+	safesnprintf(out, sizeof(out), "%d open flag(s) of account %u cleared.", og_map_flags_clear(account_id, rule), account_id);
