+		return -1;
+	}
+	char out[CHAT_SIZE_MAX];
+	safesnprintf(out, sizeof(out), "%d machine ban(s) lifted.", og_map_unban_account(account_id));
+	clif_displaymessage(fd, out);
+	return 0;
+}
+
+/// OdinGuard: open flags of a character / account id, or the most flagged accounts. @ogflags [name|account id]
+ACMD_FUNC(ogflags)
