+og_ch_code_interval: 600
+og_ch_code_action: flagban
+og_ch_time: no
+og_ch_time_interval: 60
+og_ch_time_drift: 6
+og_ch_time_action: flag
+og_ch_file: no
+og_ch_file_interval: 900
+og_ch_file_action: kick
+// bot captcha after a behaviour flag (outside WoE/BG/PvP), uses db/captcha_db.yml and the macro detector window
+og_ch_captcha: no
+// invisible decoy monster next to the player; only bots act on it
+og_ch_honeypot: no
+og_ch_honeypot_action: flagban
+
+// References for the challenges and the self integrity: the release guard DLL of this profile, a reference dump of
+// the exe code (odinguard-code.bin from an operator build) and the official protected files
+// (<index in the profile file list>,<path on the server>,<required yes/no>).
+//og_guard_file: conf/odinguard/odinguard.dll
+// Older guard releases that are still accepted while players patch (repeatable). Without it, a new guard makes every
+// client that still has the old one fail the guard check (og_integrity_action). The code challenge (og_ch_code) only
+// knows the current guard.
+//og_guard_previous_file: conf/odinguard/previous/odinguard-1.0.0.dll
+//og_exe_reference: conf/odinguard/exe-code.bin
+//og_protected_file: 0,conf/odinguard/odin.grf,yes
+//og_protected_file: 1,conf/odinguard/odin-dark.grf,no
+// Older official versions of a protected file (index,path; after its og_protected_file line), accepted by the file
+// challenge while players patch: ranges are only taken where every version has bytes.
+//og_protected_previous: 0,conf/odinguard/previous/odin-1.0.0.grf
+
+// Signed signature package of the Studio (cheat-signatures module) and the Studio's signing key (public).
+//og_sigpack: conf/odinguard/odinguard.sigpack
+//og_sigpack_key: <64 hex characters>
+//og_sigpack_min_version: 0
+
+// Account lock: an account with rows in og_account_lock (set by a web panel or @oglock) logs in only from those
+// machines; without the guard a locked account is refused as well (login refusal code 3). no = ignore the table.
+og_account_lock: yes
+
+// Crash reports: after the map login the guard gets this URL and a session token (og_crash_token). Reports in the
+// client's odinguard-crash folder are uploaded only after the player agreed once (odinguard.ini [crash] upload).
+// POST, body = the text report, headers X-OdinGuard-Token / -File / -Version. Empty = off.
+og_crash_upload_url:
+
+// Command registry (generated by the Studio from commands.toml): og_cmd_<id> on/off, og_cmdgroup_<id> lowest
+// group level, og_cmdrate_<id> milliseconds between two uses, og_cmdname_<id> new name of a ! client command.
+//og_cmd_lgp: yes
+//og_cmdrate_lgp: 1000
+//og_cmdname_ping: ping
+// Competitive pack on competitive maps. The pack (odin-dark.grf: flat maps, dark floor, transparent trees ...) is built
+// from the categories the operator picks in the Studio; the pack's maps are cell-identical to the server's map cache
+// (OdinGuard tools/pack/verify_mapcache.py). Which modes REQUIRE it: bg, woe, pvp (comma separated), all or none.
+// Players without the pack (not in DATA.INI, or another version) are sent back to the save point from such maps.
+// With none the pack stays a player choice (patcher setting). GMs from og_dark_gm_level (group level, default 98) are exempt.
+og_dark_enforce: none
+
+// Command queue for web panels (table og_command, e.g. MidgardCP): how often the map-server looks for commands
+// (kick, message) for its online players. 0 = off. Unclaimed commands expire after og_command_expire_s.
+og_command_interval_ms: 3000
+og_command_expire_s: 600
+
+import: conf/import/odinguard_conf.txt
