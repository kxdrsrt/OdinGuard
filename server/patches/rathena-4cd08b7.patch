+ACMD_FUNC(square) { nullpo_retr(-1, sd); return og_lgp_acmd(sd, command, message, 1); }
+ACMD_FUNC(circle) { nullpo_retr(-1, sd); return og_lgp_acmd(sd, command, message, 2); }
+ACMD_FUNC(aoes) { nullpo_retr(-1, sd); return og_lgp_acmd(sd, command, message, 3); }
