+}
+
+/// OdinGuard: permanent name colour (needs OdinGuard on the viewers' clients). @namecolor <RRGGBB|off>[, character]
+ACMD_FUNC(namecolor)
+{
+	char color[16], name[NAME_LENGTH] = "";
+	nullpo_retr(-1, sd);
+	if (!message || sscanf(message, "%15[^,], %23[^\n]", color, name) < 1) {
+		clif_displaymessage(fd, "Usage: @namecolor <RRGGBB|off>[, character]");
+		return -1;
+	}
+	trim(color);
+	map_session_data* pl = *name ? map_nick2sd(trim(name), false) : sd;
+	if (pl == nullptr) {
+		clif_displaymessage(fd, msg_txt(sd, 3)); // Character not found.
+		return -1;
+	}
+	int32 rgb = -1;
+	if (strcmpi(color, "off")) {
+		char* end = nullptr;
+		rgb = (int32)strtol(color[0] == '#' ? color + 1 : color, &end, 16);
+		if (end == nullptr || *end != '\0' || rgb < 0 || rgb > 0xFFFFFF) {
+			clif_displaymessage(fd, "Colour must be RRGGBB, e.g. FFD700.");
+			return -1;
+		}
+	}
+	og_map_set_namecolor(pl, rgb);
+	clif_displaymessage(fd, rgb >= 0 ? "Name colour set." : "Name colour removed.");
+	return 0;
+}
+
+/// OdinGuard: ban the machine (hardware id) of an online character. @ogban <name>[, reason]
+ACMD_FUNC(ogban)
