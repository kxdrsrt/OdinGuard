+	if (message && *message) {
+		map_session_data* pl = map_nick2sd(message, false);
+		account_id = pl != nullptr ? pl->status.account_id : (uint32)strtoul(message, nullptr, 10);
+		if (account_id == 0) {
+			clif_displaymessage(fd, msg_txt(sd, 3)); // Character not found.
+			return -1;
