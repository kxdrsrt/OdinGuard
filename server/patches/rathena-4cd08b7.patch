+/// OdinGuard: lite ground skills (flat cell tiles from odin.grf). @lgp|@square|@circle|@aoes [on|off|1-14]
+static int32 og_lgp_acmd(map_session_data* sd, const char* command, const char* message, int32 kind) {
+	static const char* ids[] = { "lgp", "square", "circle", "aoes", "lgpsound" };
+	if (!og_map_command_allowed(sd, ids[kind], 1000))
+		return -1;
