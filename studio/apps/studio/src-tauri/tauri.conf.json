{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OdinGuard Studio",
  "version": "1.0.0",
  "identifier": "org.odinguard.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OdinGuard Studio",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Configure and build OdinGuard Anti Cheat releases",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MDhBNTAxMTVFRkRDOTAKUldTUTNPOFZBYVVJWjdaOUIwcmZpWXUxN3FLSWg0WkZpQ0VhYU1aWkk1RWZieG9FM3B6UlpWa1QK",
      "endpoints": [
        "https://updates.odinguard.invalid/studio/{{target}}-{{arch}}/{{current_version}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}