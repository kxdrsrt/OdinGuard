#include <winver.h>
#include "og_version.h"
#include "og_profile.h"

1 ICON "odinguard.ico"
100 BITMAP "splash.bmp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION OG_VER_MAJOR, OG_VER_MINOR, OG_VER_PATCH, 0
PRODUCTVERSION OG_VER_MAJOR, OG_VER_MINOR, OG_VER_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", OG_PROFILE_OPERATOR
            VALUE "FileDescription", "OdinGuard Anti Cheat"
            VALUE "FileVersion", OG_VERSION_STR
            VALUE "InternalName", "odinguard"
            VALUE "LegalCopyright", "OdinGuard Anti Cheat"
            VALUE "OriginalFilename", "odinguard.dll"
            VALUE "ProductName", "OdinGuard Anti Cheat"
            VALUE "ProductVersion", OG_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
